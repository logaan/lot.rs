#!/usr/bin/env bash
# Land the current branch onto origin/main via an auto-merging pull request.
#
# This project's workflow is: do the work in a worktree on its own branch,
# then run `land` as a single command at the end of a task:
#
#   scripts/land
#
# It rebases the current branch onto origin/main, pushes the branch, opens a
# non-draft pull request, and enables auto-merge. GitHub Actions then runs the
# CI gate (ci.yml, which mirrors scripts/check) and merges the PR into main
# when it is green; branch protection on main makes those checks required, so
# a red build simply never merges. Landing is therefore asynchronous: this
# script returns as soon as the PR is queued, and the merge happens on GitHub
# a few minutes later.
#
# Safe to run: it refuses on a dirty tree, aborts (leaving nothing pushed) if
# the rebase conflicts, and no-ops when there is nothing to land. Re-running
# after fixing a red build reuses the existing PR. It force-pushes only the
# work branch (with --force-with-lease, needed after rebasing), never main.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

branch="$(git rev-parse --abbrev-ref HEAD)"

if [[ "$branch" == "HEAD" ]]; then
  echo "land: HEAD is detached; check out a branch first." >&2
  exit 1
fi

if [[ "$branch" == "main" ]]; then
  echo "land: already on main; nothing to integrate. Do your work on a branch." >&2
  exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "land: working tree has uncommitted changes. Commit them first." >&2
  exit 1
fi

echo "==> fetching origin"
git fetch --quiet origin main

if [[ -z "$(git rev-list origin/main..HEAD)" ]]; then
  echo "land: nothing to land ($branch is not ahead of origin/main)."
  exit 0
fi

echo "==> rebasing $branch onto origin/main"
if ! git rebase origin/main; then
  git rebase --abort
  echo "land: rebase onto origin/main hit conflicts. Resolve them by hand, then re-run scripts/land." >&2
  exit 1
fi

echo "==> pushing $branch to origin"
git push --force-with-lease origin "$branch"

if gh pr view "$branch" --json state --jq .state 2>/dev/null | grep -q OPEN; then
  echo "==> reusing the open pull request for $branch"
else
  echo "==> opening a pull request"
  gh pr create --base main --head "$branch" --fill
fi

# Queue the merge. --auto waits for the required CI checks and merges (rebase,
# keeping history linear) when they pass. If the checks have already passed,
# GitHub rejects --auto as unnecessary ("clean status"), so fall back to
# merging immediately — that path only exists when the build is green.
echo "==> enabling auto-merge"
if ! gh pr merge "$branch" --auto --rebase; then
  echo "==> checks already green; merging now"
  gh pr merge "$branch" --rebase
fi

echo "==> queued $branch for merge into main once CI is green:"
gh pr view "$branch" --json url --jq .url
