#!/usr/bin/env bash
# Release helper for `lot`.
#
# Usage:
#   scripts/release                                interactive (recommended)
#   scripts/release --yes <patch|minor|major|X.Y.Z>   non-interactive
#
# Walks you through cutting a release when you've forgotten the steps:
#   1. checks you're on a clean `main`
#   2. picks the new version and bumps it in Cargo.toml
#   3. runs the CI gate (scripts/check)
#   4. rolls CHANGELOG.md's `## [Unreleased]` section into `## [X.Y.Z]`
#   5. commits and tags `vX.Y.Z`
#   6. pushes (with confirmation), which triggers the release workflow
#
# Interactively, nothing is committed, tagged, or pushed without you confirming
# first. With `--yes` every confirmation (including the final push) is assumed
# yes, and the version must be given as `patch`, `minor`, `major`, or an exact
# `X.Y.Z`. See docs/release.md for the full reference.
set -euo pipefail
cd "$(dirname "$0")/.."

# --- arguments ---------------------------------------------------------------
assume_yes=0
bump_arg=""
for arg in "$@"; do
  case "$arg" in
    --yes|-y) assume_yes=1 ;;
    -h|--help)
      echo "Usage: scripts/release [--yes <patch|minor|major|X.Y.Z>]"
      echo "Interactive with no arguments; --yes assumes every confirmation."
      exit 0
      ;;
    patch|minor|major|[0-9]*) bump_arg="$arg" ;;
    *) echo "Unknown argument '$arg'. Usage: scripts/release [--yes <patch|minor|major|X.Y.Z>]" >&2; exit 1 ;;
  esac
done
if [ "$assume_yes" -eq 1 ] && [ -z "$bump_arg" ]; then
  echo "--yes needs a version: scripts/release --yes <patch|minor|major|X.Y.Z>" >&2; exit 1
fi
if [ "$assume_yes" -eq 0 ] && [ -n "$bump_arg" ]; then
  echo "A version argument requires --yes: scripts/release --yes $bump_arg" >&2; exit 1
fi

# --- pretty output -----------------------------------------------------------
if [ -t 1 ]; then
  bold=$(printf '\033[1m'); dim=$(printf '\033[2m')
  green=$(printf '\033[32m'); yellow=$(printf '\033[33m'); red=$(printf '\033[31m')
  reset=$(printf '\033[0m')
else
  bold=; dim=; green=; yellow=; red=; reset=
fi

step() { printf '\n%s==> %s%s\n' "$bold" "$1" "$reset"; }
info() { printf '    %s\n' "$1"; }
warn() { printf '%s    %s%s\n' "$yellow" "$1" "$reset"; }
die()  { printf '%s==> %s%s\n' "$red" "$1" "$reset" >&2; exit 1; }

# Ask a yes/no question. Returns 0 for yes. $2 is the default ("y" or "n").
# With --yes every question is answered yes without prompting.
confirm() {
  local prompt="$1" default="${2:-y}" reply hint
  if [ "$assume_yes" -eq 1 ]; then
    printf '%s%s%s yes %s(--yes)%s\n' "$bold" "$prompt" "$reset" "$dim" "$reset"
    return 0
  fi
  if [ "$default" = "y" ]; then hint="[Y/n]"; else hint="[y/N]"; fi
  read -r -p "$(printf '%s%s %s%s ' "$bold" "$prompt" "$hint" "$reset")" reply || die "aborted"
  reply="${reply:-$default}"
  [[ "$reply" =~ ^[Yy] ]]
}

# --- 1. preflight: clean main ------------------------------------------------
step "Checking the working tree"

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" != "main" ]; then
  warn "You're on '$branch', not 'main'. Releases are normally cut from main."
  confirm "Continue anyway?" "n" || die "aborted"
fi

if [ -n "$(git status --porcelain)" ]; then
  git status --short
  die "Working tree is not clean. Commit or stash your changes first."
fi
info "Clean, on '$branch'."

# Best-effort check that we're up to date with the remote.
if git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
  if confirm "Fetch from origin to check you're up to date?" "y"; then
    git fetch --quiet origin
    behind=$(git rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo 0)
    ahead=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0)
    [ "$behind" -gt 0 ] && warn "Local is behind origin by $behind commit(s). Consider pulling first."
    info "Ahead of origin by $ahead commit(s), behind by $behind."
  fi
fi

# --- 2. choose the new version -----------------------------------------------
step "Choosing the version"

current=$(awk -F'"' '/^version = "/ { print $2; exit }' Cargo.toml)
[ -n "$current" ] || die "Couldn't read the current version from Cargo.toml."
info "Current version: ${bold}$current${reset}"

if [[ "$current" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  maj=${BASH_REMATCH[1]}; min=${BASH_REMATCH[2]}; pat=${BASH_REMATCH[3]}
  patch_v="$maj.$min.$((pat + 1))"
  minor_v="$maj.$((min + 1)).0"
  major_v="$((maj + 1)).0.0"
else
  patch_v=; minor_v=; major_v=
  warn "Current version isn't plain X.Y.Z, so I can't suggest bumps."
fi

if [ -n "$bump_arg" ]; then
  case "$bump_arg" in
    patch) new="$patch_v" ;;
    minor) new="$minor_v" ;;
    major) new="$major_v" ;;
    *)     new="$bump_arg" ;;
  esac
  [ -n "$new" ] || die "Can't bump '$bump_arg': current version isn't plain X.Y.Z."
else
  echo
  [ -n "$patch_v" ] && info "  1) patch  -> $patch_v   (bug fixes)"
  [ -n "$minor_v" ] && info "  2) minor  -> $minor_v   (new features, backwards compatible)"
  [ -n "$major_v" ] && info "  3) major  -> $major_v   (breaking changes)"
  info "  4) custom (type it yourself)"

  read -r -p "$(printf '%sPick 1-4: %s' "$bold" "$reset")" choice || die "aborted"
  case "$choice" in
    1) new="$patch_v" ;;
    2) new="$minor_v" ;;
    3) new="$major_v" ;;
    4) read -r -p "    New version (X.Y.Z): " new ;;
    *) die "Unknown choice '$choice'." ;;
  esac
fi

[ -n "${new:-}" ] || die "No version chosen."
[[ "$new" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]] \
  || die "'$new' doesn't look like a semantic version (X.Y.Z)."

tag="v$new"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  die "Tag '$tag' already exists. Pick a different version."
fi

echo
info "Releasing ${bold}$current -> $new${reset}  (tag ${bold}$tag${reset})"
confirm "Look right?" "y" || die "aborted"

# --- 3. changelog ------------------------------------------------------------
# The `## [Unreleased]` section of CHANGELOG.md becomes this release's section
# (and the body of the GitHub Release), so check it has something in it.
step "Checking CHANGELOG.md"

[ -f CHANGELOG.md ] || die "CHANGELOG.md not found."
grep -q '^## \[Unreleased\]' CHANGELOG.md \
  || die "CHANGELOG.md has no '## [Unreleased]' section."

changelog_empty=0
if ! awk '/^## \[Unreleased\]/ { f = 1; next } f && /^## / { exit } f' CHANGELOG.md \
    | grep -q '[^[:space:]]'; then
  changelog_empty=1
  warn "CHANGELOG.md has no entries under ## [Unreleased]."
  warn "The release notes will just say '- Maintenance release.'"
  confirm "Release anyway with that placeholder entry?" "n" || die "aborted"
fi
[ "$changelog_empty" -eq 0 ] && info "Unreleased entries found."

# Move the Unreleased content into a new `## [X.Y.Z] - YYYY-MM-DD` section,
# leaving a fresh empty Unreleased at the top, and keep the comparison links
# at the bottom of the file up to date.
roll_changelog() {
  awk -v ver="$new" -v date="$(date +%Y-%m-%d)" -v empty="$changelog_empty" '
    /^## \[Unreleased\]/ {
      print "## [Unreleased]"
      print ""
      printf "## [%s] - %s\n", ver, date
      if (empty) { print ""; print "- Maintenance release."; print "" }
      in_unreleased = 1
      skip_blanks = empty
      next
    }
    in_unreleased && /^## / { in_unreleased = 0; skip_blanks = 0 }
    skip_blanks { next }
    /^\[Unreleased\]: / {
      base = $0; sub(/^\[Unreleased\]: /, "", base)
      prev = base
      sub(/\/compare\/v.*$/, "", base)
      sub(/^.*\/compare\/v/, "", prev); sub(/\.\.\.HEAD$/, "", prev)
      printf "[Unreleased]: %s/compare/v%s...HEAD\n", base, ver
      printf "[%s]: %s/compare/v%s...v%s\n", ver, base, prev, ver
      next
    }
    { print }
  ' CHANGELOG.md > CHANGELOG.md.tmp && mv CHANGELOG.md.tmp CHANGELOG.md
}

# --- 4. CI gate --------------------------------------------------------------
if confirm "Run the CI gate (scripts/check) before releasing?" "y"; then
  step "Running scripts/check"
  ./scripts/check || die "CI gate failed. Fix it before releasing."
fi

# --- 5. bump, roll, commit, tag ------------------------------------------------
step "Bumping Cargo.toml to $new and rolling CHANGELOG.md"

awk -v v="$new" '
  !done && /^version = "/ { sub(/"[^"]+"/, "\"" v "\""); done = 1 }
  { print }
' Cargo.toml > Cargo.toml.tmp && mv Cargo.toml.tmp Cargo.toml

# Refresh Cargo.lock so the new version lands there too (keeps the tree clean).
cargo update --workspace --quiet 2>/dev/null || true

roll_changelog

git --no-pager diff -- Cargo.toml Cargo.lock CHANGELOG.md

if ! confirm "Commit this as 'Release $tag' and tag it?" "y"; then
  warn "Reverting the version bump and changelog roll."
  git checkout -- Cargo.toml Cargo.lock CHANGELOG.md
  die "aborted"
fi

git add Cargo.toml Cargo.lock CHANGELOG.md
git commit --quiet -m "Release $tag"
git tag -a "$tag" -m "Release $tag"
info "Committed and tagged ${bold}$tag${reset}."

# --- 6. push -----------------------------------------------------------------
step "Pushing"
info "Pushing runs the release workflow, which builds the binaries and"
info "publishes a GitHub Release. This is the point of no return."

if confirm "Push '$branch' and tag '$tag' to origin now?" "n"; then
  git push origin "$branch"
  git push origin "$tag"
  echo
  info "${green}Done.${reset} Watch the build under the repo's Actions tab:"
  remote=$(git remote get-url origin 2>/dev/null || echo "")
  slug=$(printf '%s' "$remote" | sed -E 's#.*github.com[:/]##; s#\.git$##')
  [ -n "$slug" ] && info "  https://github.com/$slug/actions"
else
  echo
  warn "Not pushed. When you're ready, run:"
  info "  git push origin $branch"
  info "  git push origin $tag"
  info "To undo the local commit and tag instead:"
  info "  git tag -d $tag && git reset --hard HEAD~1"
fi
