#!/usr/bin/env bash
# The full pre-commit / CI gate: format check, lints, and tests.
# Composes the smaller scripts so each command has a single source of truth.
# Does not modify files (unlike lint-autofix).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> rustfmt --check"
./scripts/fmt-check

echo "==> clippy (warnings as errors)"
./scripts/lint

echo "==> tests"
./scripts/test

# Python sub-project (python/lot-textual-ui). Skipped when `uv` is not on PATH,
# mirroring how git-dependent tests skip when git is unavailable.
if command -v uv >/dev/null 2>&1; then
  echo "==> python: ruff check"
  (cd python/lot-textual-ui && uv run ruff check)
  echo "==> python: ruff format --check"
  (cd python/lot-textual-ui && uv run ruff format --check)
  echo "==> python: pytest"
  (cd python/lot-textual-ui && uv run pytest)
else
  echo "==> python: skipped (uv not found on PATH)"
fi
