#!/usr/bin/env bash
# Build `lot` in release mode, symlink it (plus the Python Textual UI
# launchers) into ~/bin, then run `lot`. Any arguments are forwarded to the
# freshly installed binary.
# Example: scripts/install thing list
#
# `lot-textual-ui` is installed because `lot interface` launches that separate
# binary (looking for it next to `lot` and then on PATH), and
# `lot-textual-ui-web` the same way for `lot web`: both are launcher scripts
# that exec the Python app through `uv run` from any directory.
set -euo pipefail
cd "$(dirname "$0")/.."

cargo build --release --bin lot

mkdir -p "$HOME/bin"
ln -sf "$PWD/target/release/lot" "$HOME/bin/lot"
echo "==> symlinked $HOME/bin/lot -> $PWD/target/release/lot"

# `lot interface` resolves `lot-textual-ui` next to `lot` or on PATH (and
# `lot web` resolves `lot-textual-ui-web` the same way); ~/bin is on PATH, so
# symlink the launchers there alongside the Rust binary.
for launcher in lot-textual-ui lot-textual-ui-web; do
  ln -sf "$PWD/python/lot-textual-ui/bin/$launcher" "$HOME/bin/$launcher"
  echo "==> symlinked $HOME/bin/$launcher -> $PWD/python/lot-textual-ui/bin/$launcher"
done

exec "$HOME/bin/lot" "$@"
