#!/usr/bin/env bash
# Build `lot` and `lot-tui` in release mode, symlink them (plus the Python
# Textual UI launcher) into ~/bin, then run `lot`. Any arguments are forwarded
# to the freshly installed binary.
# Example: scripts/install thing list
#
# `lot-tui` is installed because `lot interface` launches that separate binary
# (looking for it next to `lot` and then on PATH). `lot-textual-ui` is installed
# the same way for `lot pui`, and `lot-textual-ui-web` for `lot web`: both are
# launcher scripts that exec the Python app through `uv run` from any directory.
set -euo pipefail
cd "$(dirname "$0")/.."

cargo build --release --bin lot --bin lot-tui

mkdir -p "$HOME/bin"
for bin in lot lot-tui; do
  ln -sf "$PWD/target/release/$bin" "$HOME/bin/$bin"
  echo "==> symlinked $HOME/bin/$bin -> $PWD/target/release/$bin"
done

# `lot pui` resolves `lot-textual-ui` next to `lot` or on PATH (and `lot web`
# resolves `lot-textual-ui-web` the same way); ~/bin is on PATH, so symlink the
# launchers there alongside the Rust binaries.
for launcher in lot-textual-ui lot-textual-ui-web; do
  ln -sf "$PWD/python/lot-textual-ui/bin/$launcher" "$HOME/bin/$launcher"
  echo "==> symlinked $HOME/bin/$launcher -> $PWD/python/lot-textual-ui/bin/$launcher"
done

exec "$HOME/bin/lot" "$@"
